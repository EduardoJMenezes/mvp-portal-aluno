# Banco (Postgres local via Homebrew)
DATABASE_URL=postgresql+psycopg:///plataforma_mvp

# Sessão do portal — troque por um valor aleatório fora de desenvolvimento
JWT_SECRET=dev-only-trocar-antes-de-qualquer-coisa-real

# Vimeo: Personal Access Token de developer.vimeo.com (Authentication >
# Personal Access Tokens), com os escopos Public e Private. Não é o client
# secret. Sem token, o backend usa o acervo de demonstração embutido.
VIMEO_ACCESS_TOKEN=

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
