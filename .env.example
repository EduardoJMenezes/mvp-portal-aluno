# Banco (Postgres local via Homebrew)
DATABASE_URL=postgresql+psycopg:///plataforma_mvp

# Sessão do portal — troque por um valor aleatório fora de desenvolvimento
JWT_SECRET=dev-only-trocar-antes-de-qualquer-coisa-real

# Vimeo: Personal Access Token de developer.vimeo.com (Authentication >
# Personal Access Tokens), com os escopos Public e Private. Não é o client
# secret. Sem token, o backend usa o acervo de demonstração embutido.
VIMEO_ACCESS_TOKEN=

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie da sessão só por HTTPS. Em produção fica true (padrão); em
# desenvolvimento, por http://127.0.0.1, use false.
SESSAO_COOKIE_SEGURO=false

# Modo demonstração: a tela de entrada lista as contas @escola.demo e
# @aluno.demo e entra nelas sem senha. Nunca ligue num ambiente real.
MODO_DEMO=false

# MCP: conector remoto (claude.ai) não tem onde colar um token, só fala OAuth.
# Preenchendo as três variáveis abaixo, o servidor passa a aceitar login no
# GitHub **além** do token Bearer que o Claude Code usa. Vazias, só o token.
# Passo a passo em docs/MCP-OAUTH.md.
MCP_BASE_URL=
MCP_OAUTH_GITHUB_CLIENT_ID=
MCP_OAUTH_GITHUB_CLIENT_SECRET=

# Quem do GitHub é qual operador daqui: "login=email,outro=email".
MCP_OAUTH_OPERADORES=
